# 数据库文件路径（默认 ./data/jluai.db；服务器上建议 /opt/jluai/data/jluai.db）
# DATABASE_PATH=/opt/jluai/data/jluai.db
# Compose 内固定使用 /app/data/jluai.db，无需填写宿主机路径。

# Compose 映射到本机的端口；修改时同步修改 deploy/nginx.conf
PORT=3000

# systemd/本地运行时区（Compose 和 systemd 默认已配置）
TZ=Asia/Shanghai

# 仅用于没有反向代理的纯 HTTP 生产调试；HTTPS 部署不要启用
# FORCE_INSECURE_COOKIE=1

# 裸机在线备份目录（Compose 内固定使用 /app/backups）
# BACKUP_DIR=/opt/jluai/backups

# QQ 群链接（不配置则隐藏对应入口）
# NEXT_PUBLIC_QQ_GROUP_URL=

# 像素校园默认加载的校园包（jlu / ustc / ustc-gaoxin；也可用 URL 参数 ?campus= 运行时切换）
NEXT_PUBLIC_CAMPUS=jlu
